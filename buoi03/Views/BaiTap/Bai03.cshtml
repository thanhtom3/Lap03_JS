@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Bài 3 - Đồng hồ kỹ thuật số</title>
    <style>
        body {
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: 'Times New Roman', Times, serif;
        }

        .clock-container {
            background-color: #000000;
            padding: 40px 60px;
            border-radius: 4px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        #clock {
            color: #00aaff;
            font-size: 80px;
            font-weight: normal;
            letter-spacing: 4px;
        }
    </style>
    <script src="~/Scripts/BaiTap/Bai03.js"></script>
</head>
<body>

    <div class="clock-container">
        <div id="clock">00:00:00 AM</div>
    </div>

</body>
</html>
