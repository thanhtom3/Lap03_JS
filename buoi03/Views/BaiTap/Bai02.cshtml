@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Bài 2 - Thông tin giao hàng</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
        }

        .container {
            background-color: #fff;
            border: 1px solid #777;
            width: 700px;
            margin: 0 auto;
            padding: 20px 30px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        h2 {
            font-weight: normal;
            margin-top: 0;
            color: #333;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px 30px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

            .form-group.full-width {
                grid-column: span 2;
            }

        label {
            font-size: 13px;
            font-weight: bold;
            color: #444;
            margin-bottom: 5px;
        }

        input[type="text"] {
            padding: 8px 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
        }

            input[type="text"]:focus {
                border-color: #66afea;
                box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
            }

        .error {
            color: red;
            font-size: 12px;
            margin-top: 3px;
            min-height: 15px;
        }

        .btn-group {
            margin-top: 10px;
        }

        .btn-option {
            padding: 8px 15px;
            border: none;
            color: white;
            border-radius: 3px;
            cursor: pointer;
            font-size: 13px;
            margin-right: 5px;
        }

        .btn-blue {
            background-color: #31708f;
        }

        .btn-green {
            background-color: #5cb85c;
        }

        .btn-save {
            background-color: #d9534f;
            color: white;
            border: none;
            padding: 8px 25px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 14px;
            margin-top: 20px;
        }

            .btn-option:hover, .btn-save:hover {
                opacity: 0.9;
            }
    </style>

    <script src="~/Scripts/BaiTap/Bai02.js"></script>
</head>
<body>

    <div class="container">
        <h2>Thông tin giao hàng</h2>

        <div class="form-grid">

            <div class="form-group">
                <label>Tên</label>
                <input type="text" id="ten" onblur="kiemTraRong('ten', 'errTen', 'họ tên')">
                <span class="error" id="errTen"></span>
            </div>

            <div class="form-group">
                <label>Địa chỉ nhận hàng</label>
                <input type="text" id="diaChi" onblur="kiemTraRong('diaChi', 'errDiaChi', 'địa chỉ nhận hàng')">
                <span class="error" id="errDiaChi"></span>
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text" id="sdt" onblur="kiemTraSDT()">
                <span class="error" id="errSDT"></span>
            </div>

            <div class="form-group">
                <label>Tỉnh / thành phố</label>
                <input type="text" id="tinh" onblur="kiemTraRong('tinh', 'errTinh', 'tỉnh / thành phố')">
                <span class="error" id="errTinh"></span>
            </div>

            <div class="form-group" style="grid-column: 2;">
                <label>Quận / Huyện</label>
                <input type="text" id="quan" onblur="kiemTraRong('quan', 'errQuan', 'quận / huyện')">
                <span class="error" id="errQuan"></span>
            </div>

            <div class="form-group" style="grid-column: 2;">
                <label>Phường / Xã</label>
                <input type="text" id="phuong" onblur="kiemTraRong('phuong', 'errPhuong', 'phường / xã')">
                <span class="error" id="errPhuong"></span>
            </div>

            <div class="form-group full-width">
                <label>Lựa chọn tên cho địa chỉ thường dùng</label>
                <div class="btn-group">
                    <button class="btn-option btn-blue" onclick="chonDiaChi('vanphong')">Văn phòng</button>
                    <button class="btn-option btn-green" onclick="chonDiaChi('nharieng')">Nhà riêng</button>
                </div>
            </div>
        </div>

        <div>
            <button class="btn-save" onclick="luuThongTin()">Lưu</button>
        </div>
    </div>

</body>
</html>
